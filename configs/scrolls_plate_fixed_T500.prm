# Scrolls on Plate - PRISMS-PF 4.0.0 - AMR ON - target T=500
# Demange et al. (2017), Figure 3, crystal #10 - fixed-parameter approximation
# Domain: 320 x 320 x 51.2; coarse subdivisions 25 x 25 x 4; Q2; global refinement 3
# Initial Q2 nodal spacing: 0.8; natural zero-flux boundaries
# dt = 0.0004; 1250000 steps; 100 output intervals; configured T=500
# These initial physical parameters remain fixed (no time-dependent habit switch).

# dim = 3 and degree = 2 are compile-time constants in main.cc (do not add set dim / set degree).
set global refinement = 3
set mesh type = rectangular
subsection Rectangular mesh
  set x size = 320 
  set y size = 320
  set z size = 51.2
  set x subdivisions = 25
  set y subdivisions = 25
  set z subdivisions = 4
end

set mesh adaptivity = true
set max refinement = 3
set min refinement = 0
set remeshing period = 2500
subsection refinement criterion: 0
  set variables = phi
  set type = value
  set value lower bound = -0.99
  set value upper bound = 0.99
end

set time step = 0.0004
set number steps = 1250000
subsection output
  set condition = EQUAL_SPACING
  set number = 100
end

# Natural (zero-flux, F.nu = 0) on all six outer faces for u, phi, xi1. Full domain: these are the
# outer walls of the box, not symmetry planes.
subsection boundary conditions: 0
  set variables = u, phi, xi1
  set conditions = Natural, Natural, Natural, Natural, Natural, Natural
end

# ---- Scrolls on Plate physics (fixed initial settings from Demange Table 1; D_tilde = 0.6267 lambda)
set Model constant u0 = 0.5, DOUBLE
set Model constant eps_xy = 0.2, DOUBLE
set Model constant eps_z = 0.25, DOUBLE
set Model constant Gamma = 0.4, DOUBLE
set Model constant lambda = 3.0, DOUBLE
set Model constant D_tilde = 1.8801, DOUBLE
set Model constant Lsat = 1.0, DOUBLE

# ---- Model formulation and anisotropy options
set Model constant half_convention = variational, STRING
set Model constant q_normalization = one_sided, STRING
set Model constant gamma_structure = demange_literal, STRING
set Model constant anisotropy = pole_regular, STRING
set Model constant pole_weight = sin6, STRING

# ---- initial condition: disc germ centred in the full domain
set Model constant seed = disc, STRING
set Model constant seed_center_x = 160, DOUBLE
set Model constant seed_center_y = 160, DOUBLE
set Model constant seed_center_z = 25.6, DOUBLE
set Model constant ic_interface_width = 1.0, DOUBLE
set Model constant disc_radius = 6.4, DOUBLE
set Model constant disc_half_thickness = 1.0666666667, DOUBLE
